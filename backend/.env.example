# Copia este archivo como .env (local) o define las variables en Vercel.
# Todas son opcionales: si faltan se usan los valores por defecto de config.py.

# ID de la hoja de Google que alimenta el dashboard
SHEET_ID=1ES8FRNk3RvazGiYtM2buX4F-HNMFwERHZrbr6buHrxk

# gid de la pestana "Movimientos" (0 si es la primera)
SHEET_GID=0

# Choferes a mostrar, separados por coma. Vacio = todos.
CHOFERES_FILTRO=JFERNANDEZM,CVEGAL,PROTELANDTEMP,HSANTOSV,BRIVASL

# Segundos que se guarda la hoja en memoria antes de volver a descargarla
CACHE_TTL=300

# Origenes permitidos por CORS, separados por coma.
# No hace falta si el frontend y el backend comparten dominio en Vercel.
CORS_ORIGINS=http://localhost:5173
